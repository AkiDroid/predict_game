# 复制为 deploy/.env 后填写。密码只用字母和数字，避免 $、引号和空格。
# 生成密码: openssl rand -hex 24

# 有域名：填域名，并把 DNS A 记录指到这台服务器。
# 只有 IP：填 :80，并用 http 访问。Let's Encrypt 不能给纯 IP 签正式证书。
SITE_ADDRESS=play.example.com

# 使用域名时必填，Let's Encrypt 注册用。纯 IP 部署可留空。
ACME_EMAIL=you@example.com

# 域名部署用 1；SITE_ADDRESS=:80 时必须为 0，否则浏览器不保存登录 cookie。
COOKIE_SECURE=1

# 与浏览器地址栏的协议和主机一致，不要末尾斜杠。
CORS_ORIGIN=https://play.example.com

REDIS_PASSWORD=replace-with-openssl-rand-hex-24
SESSION_TTL_SEC=604800
